{
  "name": "vue-legal-ml-builder",
  "version": "0.2.0",
  "description": "Vue 3 component library for the BAIGLE legal-ML workbench — dataset management, model configuration/training/prediction, visualization, annotation, and experiment monitoring, driven entirely through a host-supplied backend adapter",
  "license": "MIT",
  "homepage": "https://github.com/MaastrichtU-BISS/vue-legal-ml-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaastrichtU-BISS/vue-legal-ml-builder.git"
  },
  "bugs": {
    "url": "https://github.com/MaastrichtU-BISS/vue-legal-ml-builder/issues"
  },
  "keywords": [
    "vue",
    "legal",
    "machine-learning",
    "ml",
    "legalblocks"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/vue-legal-ml-builder.umd.js",
  "module": "./dist/vue-legal-ml-builder.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-legal-ml-builder.es.js",
      "require": "./dist/vue-legal-ml-builder.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build:lib": "BUILD_MODE=lib vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:demo": "vite build",
    "build": "npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "npm run build:demo && node scripts/check-bundle-size.mjs",
    "prepublishOnly": "npm run build:lib",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^1.5.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "plotly.js-basic-dist": "^2.35.3"
  }
}
